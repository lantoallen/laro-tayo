{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "laro-tayo-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  // SQLite-backed Durable Objects are the kind included in the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "vars": {
    // Sites allowed to create rooms and connect, separated by commas.
    "ALLOWED_ORIGINS": "https://laro-tayo.vercel.app,http://localhost:3100,http://localhost:3000"
  }
}
